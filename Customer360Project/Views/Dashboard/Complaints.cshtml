@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>الشكاوي - نظام 360°</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                background: #07090f;
                font-family: 'Cairo', sans-serif;
                color: #dde6f0;
            }

            .container {
                max-width: 1200px;
                margin: 50px auto;
                padding: 20px;
            }

            .card {
                background: #111820;
                border: 1px solid #1a2535;
                border-radius: 16px;
                padding: 25px;
            }

            h1 {
                margin-bottom: 20px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 20px;
            }

            th, td {
                padding: 12px;
                text-align: right;
                border-bottom: 1px solid #1a2535;
            }

            th {
                background: #0d1117;
                color: #607590;
            }

            .btn-back {
                display: inline-block;
                background: #1d6fea;
                color: white;
                padding: 10px 20px;
                border-radius: 8px;
                text-decoration: none;
                margin-top: 20px;
            }

            .btn-add {
                background: #4ade80;
                color: black;
                border: none;
                padding: 10px 20px;
                border-radius: 8px;
                cursor: pointer;
                margin-bottom: 20px;
            }

            .btn-export {
                background: #facc15;
                color: black;
                border: none;
                padding: 10px 20px;
                border-radius: 8px;
                cursor: pointer;
                margin-right: 10px;
            }

            .form-container {
                background: #0d1117;
                padding: 20px;
                border-radius: 12px;
                margin-bottom: 20px;
                display: none;
            }

                .form-container input {
                    background: #1a2535;
                    border: none;
                    padding: 10px;
                    border-radius: 8px;
                    color: white;
                    margin-left: 10px;
                }

            .success-msg {
                background: rgba(74,222,128,0.2);
                border: 1px solid #4ade80;
                border-radius: 8px;
                padding: 10px;
                margin-bottom: 20px;
                color: #4ade80;
            }

            .edit-link {
                color: #facc15;
                margin-left: 10px;
                text-decoration: none;
            }

            .delete-link {
                color: #f87171;
                text-decoration: none;
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <h1>📋 قائمة الشكاوي</h1>

            @if (ViewBag.SuccessMessage != null)
            {
                <div class="success-msg">
                    @ViewBag.SuccessMessage
                </div>
            }

            <div>
                <button class="btn-add" onclick="showForm()">➕ إضافة شكوى جديدة</button>
                <a href="/Dashboard/ExportToExcel" class="btn-export" style="text-decoration: none;">📥 تصدير إلى Excel</a>
            </div>

            <div id="complaintForm" class="form-container">
                <h3>إضافة شكوى جديدة</h3>
                <input type="number" id="customerId" placeholder="رقم العميل">
                <input type="text" id="complaintDesc" placeholder="وصف الشكوى" style="width: 300px;">
                <button onclick="submitComplaint()" style="background: #4ade80; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer;">إرسال</button>
                <button onclick="hideForm()" style="background: #f87171; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer;">إلغاء</button>
            </div>

            <table>
                <thead>
                    <tr><th>العميل</th><th>رقم الجوال</th><th>الوصف</th><th>التاريخ</th><th>الحالة</th><th>إجراءات</th></tr>
                </thead>
                <tbody>
                    @if (ViewBag.Complaints != null)
                    {
                        @foreach (var t in ViewBag.Complaints)
                        {
                            <tr>
                                <td>@t.Customer?.FullName</td>
                                <td>@t.Customer?.PhoneNumber</td>
                                <td>@t.Description</td>
                                <td>@t.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td><span style="color:#facc15;">@t.Status</span></td>
                                <td>
                                    <a href="/Dashboard/EditTicket?id=@t.Id" class="edit-link">✏️ تعديل</a>
                                    <a href="/Dashboard/DeleteTicket?id=@t.Id" class="delete-link" onclick="return confirm('هل أنت متأكد؟')">🗑️ حذف</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <a href="/Dashboard/Index" class="btn-back">🔙 العودة للوحة التحكم</a>
        </div>
    </div>

    <script>
            function showForm() {
                document.getElementById('complaintForm').style.display = 'block';
            }

            function hideForm() {
                document.getElementById('complaintForm').style.display = 'none';
            }

            function submitComplaint() {
                var customerId = document.getElementById('customerId').value;
                var description = document.getElementById('complaintDesc').value;

                if(customerId && description) {
                    window.location.href = '/Dashboard/AddComplaint?customerId=' + customerId + '&description=' + encodeURIComponent(description);
                } else {
                    alert('الرجاء إدخال جميع البيانات');
                }
            }
    </script>
</body>
</html>
