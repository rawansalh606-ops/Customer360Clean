@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>التقارير - نظام 360°</title>
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                background: #07090f;
                font-family: 'Cairo', sans-serif;
                color: #dde6f0;
            }

            .container {
                max-width: 1200px;
                margin: 50px auto;
                padding: 20px;
            }

            .card {
                background: #111820;
                border: 1px solid #1a2535;
                border-radius: 16px;
                padding: 25px;
            }

            .stats-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
                margin: 30px 0;
            }

            .stat {
                background: #0d1117;
                padding: 20px;
                border-radius: 12px;
                text-align: center;
            }

                .stat .number {
                    font-size: 40px;
                    font-weight: 900;
                    color: #4ade80;
                }

                .stat .label {
                    color: #607590;
                    margin-top: 10px;
                }

            .btn-back {
                display: inline-block;
                background: #1d6fea;
                color: white;
                padding: 10px 20px;
                border-radius: 8px;
                text-decoration: none;
                margin-top: 20px;
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <h1>📊 التقارير والإحصائيات</h1>
            <div class="stats-grid">
                <div class="stat"><div class="number">@ViewBag.TotalCustomers</div><div class="label">إجمالي العملاء</div></div>
                <div class="stat"><div class="number" style="color:#f87171;">@ViewBag.TotalComplaints</div><div class="label">إجمالي الشكاوي</div></div>
                <div class="stat"><div class="number" style="color:#facc15;">@ViewBag.OpenTickets</div><div class="label">تذاكر مفتوحة</div></div>
                <div class="stat"><div class="number" style="color:#4ade80;">@ViewBag.ClosedTickets</div><div class="label">تذاكر مغلقة</div></div>
            </div>
            <a href="/Dashboard/Index" class="btn-back">🔙 العودة للوحة التحكم</a>
        </div>
    </div>
</body>
</html>
